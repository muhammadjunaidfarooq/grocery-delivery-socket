# ---------- Local development ----------
# Copy to .env for local runs. On Render, set these in Environment instead
# (Render provides PORT automatically, so do not set it there).
PORT=4000

# URL of the Next.js app, no trailing slash.
# Production: your Vercel URL, e.g. https://your-app.vercel.app  (REQUIRED in production)
NEXT_BASE_URL=http://localhost:3000

# Optional: comma-separated browser origins allowed by CORS.
# Defaults to NEXT_BASE_URL. Add a custom domain here if you use one.
CLIENT_ORIGINS=http://localhost:3000

# Shared secret. Must be EXACTLY the same as SOCKET_SERVER_SECRET in the Vercel project.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOCKET_SERVER_SECRET=change-me-to-a-long-random-string
